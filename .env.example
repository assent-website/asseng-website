# Copiez ce fichier vers .env.local puis remplissez les valeurs.
# ⚠️ Ne committez JAMAIS .env.local — il est dans .gitignore et doit le rester.
# Sur Vercel, ces variables se configurent dans Settings → Environment Variables,
# pas dans le dépôt.

# --- Tencent Exmail SMTP (formulaire de contact) ---
EXMAIL_ADDRESS=
EXMAIL_AUTH_CODE=
EXMAIL_FROM=
EXMAIL_RECIPIENTS=
EXMAIL_SMTP_HOST=
EXMAIL_SMTP_PORT=

# --- Google Gemini (assistant / pages/api/chat.js) ---
GEMINI_API_KEY=

# --- Divers ---
NEXT_PUBLIC_API_URL=
